pipeline {
    agent any

    tools {
        maven 'mvn3.9'
    }

    environment {
        IMAGE_NAME = 'san2-calcus'
        CONTAINER_NAME = 'con2-san-calcus'
    }

    parameters {
        choice(name: 'APP_ENV', choices: ['testing','production'], description: 'Environment name - testing / production')
    }

    stages {
        stage('1 - Checkout') {
            steps {
                git branch: 'main', credentialsId: 'kaviim-', url: 'https://github.com/kaviiM/Kavi--.git'
            }
        }
        stage('2 - Build JAR') {
            when {
                expression {
                    return params.APP_ENV == 'testing'
                }
            }
            steps {
                bat 'mvn clean install -DskipTests=true'
            }
        }
        stage('3 - Docker Build') {
            steps {
                bat 'set "PATH=%PATH%;C:\\Program Files\\Docker\\Docker\\resources\\bin" && docker build --no-cache -t %IMAGE_NAME% .'
            }
        }
        stage('4 - Docker Run') {
            steps {
                bat '''
                    set "PATH=%PATH%;C:\\Program Files\\Docker\\Docker\\resources\\bin"
                    docker rm -f %CONTAINER_NAME% || echo "No old container"
                    docker run -d -p 8097:8090 --name=%CONTAINER_NAME% %IMAGE_NAME%
                    docker ps
                    docker logs %CONTAINER_NAME%
                '''
            }
        }
    }
}
